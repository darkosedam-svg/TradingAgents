# Copy to .env next to docker-compose.yml and edit for your card.
#
# Pick the row that matches your VRAM. Qwen2.5-Instruct is the choice because it
# is the most quant-robust family for structured output and tool calling, which
# is exactly what this layer stresses.
#
#   >= 24 GB   Qwen/Qwen2.5-14B-Instruct-AWQ   primary reasoning/triage
#   12-24 GB   Qwen/Qwen2.5-7B-Instruct-AWQ    primary
#   any        Qwen/Qwen2.5-3B-Instruct-AWQ    high-volume classify only,
#                                              never tool-calling
MODEL_ID=Qwen/Qwen2.5-14B-Instruct-AWQ

# awq_marlin, not plain awq — same weights, much faster kernel. Step *up* to
# fp8 (Ada/Hopper) or int8 if Gate A fails; never step down to 3-bit.
QUANTIZATION=awq_marlin

MAX_LEN=8192
GPU_UTIL=0.90

# Pin the image. An upgrade here is a change to the serving substrate: bump the
# tag, re-run the golden sets, then keep it.
VLLM_TAG=v0.6.3.post1

# Only needed for gated repos.
HUGGING_FACE_HUB_TOKEN=

# --- consumed by services/llm/client, not by compose ---
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
LLM_API_KEY=EMPTY
LLM_TIMEOUT_S=8
LLM_MAX_RETRIES=1
LLM_BREAKER_THRESHOLD=3
LLM_BREAKER_COOLDOWN_S=30
